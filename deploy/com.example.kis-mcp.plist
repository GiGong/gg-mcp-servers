<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.kis-mcp</string>

  <!-- .venv/bin/kis-mcp 는 editable 설치로 만들어진 콘솔 스크립트다.
       인터프리터는 uv 관리 CPython 3.13 을 가리킨다. -->
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/kis-mcp/.venv/bin/kis-mcp</string>
  </array>

  <!-- .env 를 프로젝트 루트에서 읽으므로 반드시 필요하다. -->
  <key>WorkingDirectory</key>
  <string>/path/to/kis-mcp</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- 부팅/로그인 시 자동 기동, 죽으면 자동 재시작 -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/kis-mcp/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/kis-mcp/stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

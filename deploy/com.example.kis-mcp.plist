<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. Do not install this file directly.

  Run deploy/install.sh to substitute __PROJECT_DIR__ / __HOME__ / __LABEL__
  and write the result to ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- Console script created by `uv pip install -e .`, backed by the venv
       interpreter. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/.venv/bin/kis-mcp</string>
  </array>

  <!-- Required: the server reads .env from the project root. -->
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <!-- Start at login/boot, restart on abnormal exit. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kis-mcp/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kis-mcp/stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

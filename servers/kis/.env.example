# ==========================================================================
# kis-mcp configuration
#   cp .env.example .env && chmod 600 .env
#   .env is gitignored. Never put real credentials in this example file.
# ==========================================================================

# --------------------------------------------------------------------------
# KIS Open API
# --------------------------------------------------------------------------
# real = live trading  (https://openapi.koreainvestment.com:9443)
# demo = paper trading (https://openapivts.koreainvestment.com:29443)
#   Note: paper accounts are limited to 5 req/s, and the provisional
#   investor-flow endpoint (HHPTJ04160200) plus parts of the overseas quote
#   API may not be available there.
KIS_ENV=real

# Issued at https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=

# Access-token cache. Created with 0600 permissions.
KIS_TOKEN_CACHE=~/.cache/kis-mcp/token.json

# Request throttle. KIS allows 20/s (live) and 5/s (paper) per app key.
# Startup fails if this exceeds the ceiling for the selected KIS_ENV.
KIS_RATE_LIMIT_PER_SEC=8

# Per-request timeout in seconds.
KIS_TIMEOUT=10

# Set to true only if your KIS account subscribes to real-time overseas data.
# When false, overseas responses are flagged as delayed (typically 15 min).
KIS_OVERSEAS_REALTIME=false

# --------------------------------------------------------------------------
# KRX Open API (optional)
# --------------------------------------------------------------------------
# Cross-checks regular-session closes against KRX's official daily data, which
# is published the next day. Leave empty to skip; every tool works without it.
# Issue a key at https://openapi.krx.co.kr and apply for 유가증권 일별매매정보
# (plus 코스닥 일별매매정보 for KOSDAQ symbols). Each is approved separately.
KRX_AUTH_KEY=

# --------------------------------------------------------------------------
# MCP server (Streamable HTTP)
# --------------------------------------------------------------------------
# Bind to loopback; a tunnel or reverse proxy fronts this.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp

# The public HTTPS URL, without a path or trailing slash.
# This becomes the OAuth issuer and redirect base, so it must match the real
# public URL exactly or the connector will fail to connect.
MCP_PUBLIC_URL=https://mcp.example.com

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------
# oauth = built-in OAuth 2.1 authorization server (required for Claude.ai)
# none  = no auth. Loopback testing only. Never expose this publicly.
AUTH_MODE=oauth

# Typed in the browser to approve a connection. Long and random.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_PASSPHRASE=

# HMAC key for token digests. Must differ from the passphrase.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_SIGNING_SECRET=

# The login page is reachable without authentication. Keep these neutral so
# they do not reveal what the server is for.
AUTH_PAGE_LABEL=Private connector
AUTH_PAGE_SUBTITLE=Enter the passphrase to connect.

# Token lifetimes in seconds. Defaults: 8 hours / 30 days.
OAUTH_ACCESS_TOKEN_TTL=28800
OAUTH_REFRESH_TOKEN_TTL=2592000

# Registered clients and token digests (0600).
OAUTH_STORE=~/.cache/kis-mcp/oauth-store.json

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# Credentials and account numbers are masked before anything is written.
LOG_LEVEL=INFO
LOG_FILE=~/Library/Logs/kis-mcp/kis-mcp.log

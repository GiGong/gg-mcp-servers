# ==========================================================================
# lostark-mcp configuration
#   cp .env.example .env && chmod 600 .env
#   .env is gitignored. Never put real credentials in this example file.
# ==========================================================================

# --------------------------------------------------------------------------
# Lost Ark Open API
# --------------------------------------------------------------------------
# The JWT from https://developer-lostark.game.onstove.com/clients, as is,
# WITHOUT the "bearer " prefix. It does not expire until you delete the client,
# so treat a leak as permanent until you do.
LOSTARK_API_KEY=

# The API allows 100 requests per minute per key. Startup fails above 100.
LOSTARK_RATE_LIMIT_PER_MIN=90

# Per-request timeout, and the longest a tool call will wait for quota before
# returning a rate_limited error instead.
LOSTARK_TIMEOUT=15
LOSTARK_MAX_WAIT_SEC=15

# --------------------------------------------------------------------------
# Ranker statistics (lostark-mcp collect / stats_builds)
# --------------------------------------------------------------------------
# Relative paths resolve against servers/lostark/. local/ is gitignored: both
# files hold other players' character names.
LOSTARK_RANKERS_FILE=local/rankers.txt
LOSTARK_SNAPSHOT_DB=local/snapshots.sqlite3

# The collector's own share of the quota, and how many requests it leaves for
# the running server: it pauses while the API reports this many or fewer left.
LOSTARK_COLLECT_RATE_LIMIT_PER_MIN=50
LOSTARK_COLLECT_RESERVE=30

# --------------------------------------------------------------------------
# MCP server (Streamable HTTP)
# --------------------------------------------------------------------------
# Bind to loopback; a tunnel or reverse proxy fronts this.
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_PATH=/mcp

# The public HTTPS URL, without a path or trailing slash.
# This becomes the OAuth issuer and redirect base, so it must match the real
# public URL exactly or the connector will fail to connect.
MCP_PUBLIC_URL=https://mcp.example.com

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------
# oauth = built-in OAuth 2.1 authorization server (required for Claude.ai)
# none  = no auth. Loopback testing only. Never expose this publicly.
AUTH_MODE=oauth

# Typed in the browser to approve a connection. Long and random.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_PASSPHRASE=

# HMAC key for token digests. Must differ from the passphrase.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_SIGNING_SECRET=

# The login page is reachable without authentication. Keep these neutral so
# they do not reveal what the server is for.
AUTH_PAGE_LABEL=Private connector
AUTH_PAGE_SUBTITLE=Enter the passphrase to connect.

# Token lifetimes in seconds. Defaults: 8 hours / 30 days.
OAUTH_ACCESS_TOKEN_TTL=28800
OAUTH_REFRESH_TOKEN_TTL=2592000

# Registered clients and token digests (0600).
OAUTH_STORE=~/.cache/lostark-mcp/oauth-store.json

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# The API key is masked before anything is written.
LOG_LEVEL=INFO
LOG_FILE=~/Library/Logs/lostark-mcp/lostark-mcp.log

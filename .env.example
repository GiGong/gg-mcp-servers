# ==========================================================================
# kis-mcp  환경설정 예시
#   cp .env.example .env  후 값을 채우세요. .env 는 .gitignore 에 있습니다.
#   이 파일에는 실제 자격증명을 절대 쓰지 마세요.
# ==========================================================================

# --------------------------------------------------------------------------
# KIS Open API
# --------------------------------------------------------------------------
# real = 실전투자 (https://openapi.koreainvestment.com:9443)
# demo = 모의투자 (https://openapivts.koreainvestment.com:29443)
#   주의: 모의투자는 유량이 5건/초이고, 종목별 외인기관 추정가집계
#   (HHPTJ04160200) 및 해외주식 시세 일부가 지원되지 않을 수 있습니다.
KIS_ENV=real

KIS_APP_KEY=
KIS_APP_SECRET=

# 접근토큰 캐시 경로. 파일은 0600 으로 생성됩니다.
KIS_TOKEN_CACHE=~/.cache/kis-mcp/token.json

# 유량 제한. KIS 공식 한도는 실전 20건/초, 모의 5건/초.
# 여유를 두고 기본값을 보수적으로 잡습니다.
KIS_RATE_LIMIT_PER_SEC=8

# KIS 호출 타임아웃(초)
KIS_TIMEOUT=10

# KIS 해외주식 실시간 시세를 신청한 계정인지 여부.
# false 면 해외 시세 응답에 "지연 시세"로 표시됩니다(미국 통상 15분 지연).
KIS_OVERSEAS_REALTIME=false

# --------------------------------------------------------------------------
# MCP 서버 (Streamable HTTP)
# --------------------------------------------------------------------------
# cloudflared 가 같은 호스트에서 프록시하므로 루프백에만 바인딩합니다.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp

# Cloudflare Tunnel 로 노출되는 공개 URL (경로 제외, 슬래시 없이).
# OAuth 메타데이터의 issuer / redirect 검증에 사용되므로 정확해야 합니다.
MCP_PUBLIC_URL=https://mcp.example.com

# --------------------------------------------------------------------------
# 인증
# --------------------------------------------------------------------------
# oauth = 내장 OAuth 2.1 인가서버 (Claude.ai 커스텀 커넥터용, 권장)
# none  = 인증 없음. 루프백 로컬 테스트 전용. 절대 터널에 노출하지 마세요.
AUTH_MODE=oauth

# 브라우저 인증 화면에서 입력할 패스프레이즈. 길고 무작위하게.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
OAUTH_PASSPHRASE=

# 액세스 토큰 서명용 비밀키. 위와 다른 값으로.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
OAUTH_SIGNING_SECRET=

# 인증 화면은 인증 없이 누구나 열 수 있습니다.
# 서버 용도가 드러나지 않는 중립적인 문구를 쓰세요.
AUTH_PAGE_LABEL=mcp.example.com
AUTH_PAGE_SUBTITLE=연결하려면 패스프레이즈를 입력하세요.

# 발급 토큰 수명(초). 기본 8시간 / 리프레시 30일.
OAUTH_ACCESS_TOKEN_TTL=28800
OAUTH_REFRESH_TOKEN_TTL=2592000

# OAuth 클라이언트/토큰 상태 저장 경로 (0600).
OAUTH_STORE=~/.cache/kis-mcp/oauth-store.json

# --------------------------------------------------------------------------
# 로깅
# --------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=~/Library/Logs/kis-mcp/kis-mcp.log
